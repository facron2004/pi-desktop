{
  "name": "pi-desktop",
  "version": "0.10.16",
  "description": "Pi Desktop — a native GUI for the Pi coding agent",
  "main": "./out/main/index.js",
  "author": "Facron",
  "homepage": "https://github.com/facron2004/pi-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/facron2004/pi-desktop.git"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-lock.mjs dev",
    "dev:desktop": "node scripts/build-lock.mjs dev:desktop",
    "remote:watch": "node scripts/build-lock.mjs remote:watch",
    "start": "node scripts/build-lock.mjs start",
    "build": "node scripts/build-lock.mjs build",
    "build:remote": "node scripts/build-lock.mjs build:remote",
    "__dev": "node scripts/dev.mjs",
    "__dev:desktop": "electron-vite dev",
    "__remote:watch": "vite build --config vite.remote.config.ts --watch",
    "__start": "electron-vite preview",
    "__build:main": "electron-vite build",
    "__build:remote": "vite build --config vite.remote.config.ts",
    "__build": "npm run __build:main && npm run __build:remote",
    "__dist": "npm run __build && electron-builder",
    "__dist:dir": "npm run __build && electron-builder --dir",
    "__test:ui": "npm run __build && node tests/ui-regressions.mjs",
    "__test:e2e": "node tests/e2e-run.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "icon": "electron scripts/make-icon.mjs",
    "dist": "node scripts/build-lock.mjs dist",
    "dist:dir": "node scripts/build-lock.mjs dist:dir",
    "test": "node tests/run.mjs",
    "test:e2e": "node scripts/build-lock.mjs test:e2e",
    "test:ui": "node scripts/build-lock.mjs test:ui"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cross-spawn": "7.0.6",
    "diff": "^9.0.0",
    "lucide-react": "^1.59.0",
    "node-pty": "^1.1.0",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.10.2",
    "electron-builder": "^26.18.1",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1",
    "fast-uri@>=3.0.0 <3.1.9": "3.1.9"
  }
}
